# Postgres connection string. Supabase: Connect -> Session pooler -> URI (port 5432).
DATABASE_URL=postgresql://postgres:reflex@127.0.0.1:54329/postgres
# Stripe test-mode secret key (sk_test_...). Empty = stub payments (see STUBS.md).
STRIPE_SECRET_KEY=
HOST=127.0.0.1
PORT=8000
MCP_USE_ANONYMIZED_TELEMETRY=false

# Phase 5: when the marketplace runs where Docker is unavailable (e.g. Manufact), point it at server/runner.py.
SANDBOX_URL=
SANDBOX_TOKEN=
